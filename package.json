{
  "name": "@bluearpit/pi-customizations",
  "version": "0.4.0",
  "private": false,
  "type": "module",
  "description": "Portable Pi extensions for context, side chats, tool approvals, and restricted background workers",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/context.ts",
      "./extensions/side.ts",
      "./extensions/notify.ts",
      "./extensions/permissions.ts",
      "./extensions/background.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.6",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
