{
  "name": "@bluearpit/pi-customizations",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Portable Pi extensions for context usage and ephemeral side chats",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./extensions/context.ts", "./extensions/side.ts", "./extensions/notify.ts"]
